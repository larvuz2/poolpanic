"AppBuild"
{
	// Fill in the two ids Steamworks gives the app (Steamworks > your app > SteamPipe > Depots), then upload with
	//   steamcmd +login <build account> +run_app_build "<full path>/desktop/steam/app_build.vdf" +quit
	"AppID" "YOUR_APP_ID"
	"Desc" "Pool Panic build"
	// "Preview" "1" only lists what would be uploaded.
	"Preview" "0"
	// The branch to put the build on. Leave empty to upload without making it live: then pick it in Steamworks > SteamPipe > Builds.
	// Never "default" from here until the game is released: test on a branch such as "beta" first.
	"SetLive" ""
	"ContentRoot" "..\out\"
	"BuildOutput" "..\steam\output\"

	"Depots"
	{
		// One depot per operating system, each with the files `npm run pack:<os>` leaves in out/.
		"YOUR_DEPOT_ID_WINDOWS"
		{
			"FileMapping"
			{
				"LocalPath" "win-unpacked\*"
				"DepotPath" "."
				"Recursive" "1"
			}
		}
		"YOUR_DEPOT_ID_LINUX"
		{
			"FileMapping"
			{
				"LocalPath" "linux-unpacked\*"
				"DepotPath" "."
				"Recursive" "1"
			}
		}
		"YOUR_DEPOT_ID_MACOS"
		{
			"FileMapping"
			{
				// An Apple Silicon build and an Intel one are two folders; ship the universal one when both are packed together.
				"LocalPath" "mac-arm64\*"
				"DepotPath" "."
				"Recursive" "1"
			}
		}
	}
}
